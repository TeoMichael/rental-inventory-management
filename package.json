{
  "name": "rental-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write src tests docs *.json *.ts *.mts *.mjs README.md",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-rental-rules --only firestore,storage \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
    "firebase": "13.0.0",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "15.33.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
