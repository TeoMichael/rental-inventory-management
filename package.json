{
  "name": "rental-inventory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write src tests docs *.json *.ts *.mts *.mjs README.md",
    "dev": "node scripts/dev.mjs dev --hostname 127.0.0.1",
    "build": "next build",
    "cloudflare:build": "node scripts/check-cloudflare-env.mjs && opennextjs-cloudflare build",
    "cloudflare:preview": "node scripts/check-cloudflare-env.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "node scripts/check-cloudflare-env.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --config firebase.emulators.json --project demo-rental-rules --only firestore,storage \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "firebase": "13.0.0",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "15.33.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
