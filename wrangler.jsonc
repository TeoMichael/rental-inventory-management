{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keyline-rental-inventory",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "alias": {
    "server-only": "./scripts/cloudflare-server-only.mjs",
  },
  // Runtime secrets are set with Wrangler's secret mechanism. Keep values
  // outside this file. No paid storage, image, queue, or database bindings.
}
